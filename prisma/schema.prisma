generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id        String      @id @default(uuid())
  name      String
  date      DateTime
  budget    Float
  status    String      @default("PLANNING")
  items     Item[]
  createdById String?
  assignedToId String?
  finalizedById String?
  completedAt DateTime?
  finalAttendance Int?
  finalBudgetUsed Float?
  finalNotes String?
  archiveVersion Int @default(0)
  createdBy User? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("EventAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  finalizedBy User? @relation("EventFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  archives EventArchive[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Item {
  id        String     @id @default(uuid())
  name      String
  category  String
  fee       Float
  status    String     @default("PROSPECT")
  notes     String?
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
  documents Document[]
  createdAt DateTime   @default(now())
}

model Contact {
  id           String   @id @default(uuid())
  businessName String
  category     String
  contactName  String?
  phone        String?
  email        String?
  notes        String?
  items        Item[]
  createdAt    DateTime @default(now())
}

model Document {
  id         String   @id @default(uuid())
  filePath   String
  fileName   String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  uploadedAt DateTime @default(now())
}

model SocialPost {
  id           String   @id @default(uuid())
  title        String
  platforms    String[]
  type         String
  status       String   @default("IDEA")
  postUrl      String?
  caption      String?
  hashtags     String?
  scheduledFor DateTime?
  postedAt     DateTime?
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  views        Int      @default(0)
  publicLikes    Int      @default(0)
  publicComments Int      @default(0)
  publicShares   Int      @default(0)
  publicViews    Int      @default(0)
  lastSyncedAt   DateTime?
  createdById    String?
  createdBy      User?    @relation("SocialPostAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("VIEWER")
  department String   @default("ADMIN")
  orgId      String   @default("RALLY_MAIN")
  createdAt  DateTime @default(now())
  socialPosts SocialPost[] @relation("SocialPostAuthor")
  eventsCreated Event[] @relation("EventCreator")
  eventsAssigned Event[] @relation("EventAssignee")
  eventsFinalized Event[] @relation("EventFinalizer")
  generatedEventArchives EventArchive[] @relation("EventArchiveGenerator")
  createdTasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  activityLogs ActivityLog[]
  uploadedDocuments GlobalDocument[]
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  relatedType String
  relatedId   String?
  assignedToId String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo  User?    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
}

model GlobalDocument {
  id          String   @id @default(uuid())
  name        String
  fileUrl     String
  relatedType String
  relatedId   String?
  uploadedById String?
  uploadedAt  DateTime @default(now())
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

model EventArchive {
  id            String   @id @default(uuid())
  eventId        String
  version        Int
  generatedAt    DateTime @default(now())
  generatedById  String?
  archiveUrl     String
  summaryPdfUrl  String
  budgetCsvUrl   String
  vendorCsvUrl   String
  socialCsvUrl   String
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  generatedBy    User?   @relation("EventArchiveGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([eventId, version])
}
