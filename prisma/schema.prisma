generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id        String      @id @default(uuid())
  name      String
  date      DateTime
  budget    Float
  eventType String?
  playbook  Json?
  status    String      @default("PLANNING")
  items     Item[]
  createdById String?
  assignedToId String?
  finalizedById String?
  templateId String?
  completedAt DateTime?
  finalAttendance Int?
  finalBudgetUsed Float?
  finalNotes String?
  archiveVersion Int @default(0)
  createdBy User? @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("EventAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  finalizedBy User? @relation("EventFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  template EventTemplate? @relation("EventTemplateUsage", fields: [templateId], references: [id], onDelete: SetNull)
  archives EventArchive[]
  debriefs EventDebrief[]
  contactLinks EventContact[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Item {
  id        String     @id @default(uuid())
  name      String
  category  String
  fee       Float
  status    String     @default("PROSPECT")
  notes     String?
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?
  documents Document[]
  createdAt DateTime   @default(now())
}

model Contact {
  id           String   @id @default(uuid())
  firstName    String?
  lastName     String?
  businessName String
  company      String?
  category     String
  contactName  String?
  phone        String?
  email        String?
  contactType  String   @default("VENDOR")
  source       String   @default("OTHER")
  assignedToId String?
  status       String   @default("NEW")
  leadScore    Int      @default(0)
  notes        String?
  items        Item[]
  interactions Interaction[]
  eventLinks   EventContact[]
  socialLinks  SocialPostContact[]
  assignedTo   User? @relation("ContactAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  templateVendors TemplateVendor[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Document {
  id         String   @id @default(uuid())
  filePath   String
  fileName   String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  uploadedAt DateTime @default(now())
}

model SocialPost {
  id           String   @id @default(uuid())
  title        String
  platforms    String[]
  type         String
  status       String   @default("IDEA")
  postUrl      String?
  caption      String?
  hashtags     String?
  scheduledFor DateTime?
  postedAt     DateTime?
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  views        Int      @default(0)
  publicLikes    Int      @default(0)
  publicComments Int      @default(0)
  publicShares   Int      @default(0)
  publicViews    Int      @default(0)
  lastSyncedAt   DateTime?
  createdById    String?
  createdBy      User?    @relation("SocialPostAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  contactLinks   SocialPostContact[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       String   @default("VIEWER")
  department String   @default("ADMIN")
  orgId      String   @default("RALLY_MAIN")
  createdAt  DateTime @default(now())
  socialPosts SocialPost[] @relation("SocialPostAuthor")
  eventsCreated Event[] @relation("EventCreator")
  eventsAssigned Event[] @relation("EventAssignee")
  eventsFinalized Event[] @relation("EventFinalizer")
  createdEventTemplates EventTemplate[] @relation("EventTemplateCreator")
  generatedEventDebriefs EventDebrief[] @relation("EventDebriefGenerator")
  generatedEventArchives EventArchive[] @relation("EventArchiveGenerator")
  assignedContacts Contact[] @relation("ContactAssignee")
  createdInteractions Interaction[] @relation("InteractionCreator")
  createdTasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  activityLogs ActivityLog[]
  uploadedDocuments GlobalDocument[]
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  relatedType String
  relatedId   String?
  assignedToId String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo  User?    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
}

model GlobalDocument {
  id          String   @id @default(uuid())
  name        String
  fileUrl     String
  relatedType String
  relatedId   String?
  uploadedById String?
  uploadedAt  DateTime @default(now())
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

model EventArchive {
  id            String   @id @default(uuid())
  eventId        String
  version        Int
  generatedAt    DateTime @default(now())
  generatedById  String?
  archiveUrl     String
  summaryPdfUrl  String
  budgetCsvUrl   String
  vendorCsvUrl   String
  socialCsvUrl   String
  event          Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  generatedBy    User?   @relation("EventArchiveGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([eventId, version])
}

model EventTemplate {
  id                    String   @id @default(uuid())
  name                  String
  description           String?
  eventType             String?
  defaultBudgetCategories Json?
  defaultTaskChecklist  Json?
  timelineMilestones    Json?
  createdById           String?
  archivedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             User?    @relation("EventTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  templateVendors       TemplateVendor[]
  events                Event[]  @relation("EventTemplateUsage")
}

model TemplateVendor {
  id                  String   @id @default(uuid())
  templateId          String
  vendorId            String
  defaultCostEstimate Float?
  category            String
  priorityLevel       String   @default("PRIMARY")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  template            EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  vendor              Contact  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([templateId, vendorId, priorityLevel])
}

model EventDebrief {
  id            String   @id @default(uuid())
  eventId        String
  version        Int      @default(1)
  generatedAt    DateTime @default(now())
  generatedById  String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  generatedBy    User?    @relation("EventDebriefGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@unique([eventId, version])
}

model Interaction {
  id           String   @id @default(uuid())
  contactId    String
  type         String
  summary      String
  followUpDate DateTime?
  createdById  String?
  createdAt    DateTime @default(now())
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation("InteractionCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

model EventContact {
  id              String   @id @default(uuid())
  eventId         String
  contactId       String
  roleTag         String?
  convertedToLead Boolean  @default(false)
  createdAt       DateTime @default(now())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId])
}

model SocialPostContact {
  id               String   @id @default(uuid())
  socialPostId     String
  contactId        String
  relationshipType String   @default("COMMENTER")
  createdAt        DateTime @default(now())
  socialPost       SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)
  contact          Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([socialPostId, contactId])
}
